<Window x:Class="NeuroGenesisAI.VisualizerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeuroGenesisAI Visualizer" Height="800" Width="1000">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Canvas Name="BrainCanvas" Background="Black" 
                MouseWheel="BrainCanvas_MouseWheel"
                MouseLeftButtonDown="BrainCanvas_MouseLeftButtonDown"
                MouseLeftButtonUp="BrainCanvas_MouseLeftButtonUp"
                MouseMove="BrainCanvas_MouseMove">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BrainScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="BrainTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Canvas.RenderTransform>
        </Canvas>
    </ScrollViewer>
</Window>
